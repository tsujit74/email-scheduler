generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  scheduled
  processing
  completed
  cancelled
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
}

model User {
  id               String   @id @default(uuid())
  googleId         String   @unique
  name             String
  email            String   @unique
  avatarUrl        String?
  hourlyEmailLimit Int      @default(200)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaigns Campaign[]

  @@index([createdAt])
}

model Campaign {
  id                 String         @id @default(uuid())
  userId             String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int
  status             CampaignStatus @default(scheduled)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
  @@index([status])
  @@index([startTime])
}

model Email {
  id                String      @id @default(uuid())
  campaignId        String
  recipient         String
  subject            String
  body              String
  scheduledAt        DateTime
  sentAt            DateTime?
  status            EmailStatus @default(scheduled)
  attempts          Int         @default(0)
  providerMessageId String?
  idempotencyKey    String      @unique
  errorMessage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipient])
  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
}